# Dev-only password. Copy this file to .env before starting Compose.
POSTGRES_PASSWORD=local-dev-only
TALLYMED_WEB_PORT=3001
# Origin browsers use. Production must be https at a dedicated host (http is allowed only for loopback).
TALLYMED_CANONICAL_ORIGIN=http://127.0.0.1:3001
# Optional: 32+ character secret shared with the reverse proxy so forwarded headers are trusted. Leave empty without a proxy.
TALLYMED_PROXY_SECRET=
# Optional one-time setup token for creating the first administrator at /setup (32 to 128 random printable characters, e.g. `openssl rand -base64 32`).
# Leave it empty and the server generates one while no administrator exists and prints it to its console (`docker compose logs web`).
# It is ignored once an administrator exists; remove it afterwards. The dev-up launcher generates and shows one for you when this is empty.
TALLYMED_SETUP_TOKEN=
# Optional: addresses or CIDR ranges of a reverse proxy in front of the app (an administrator can also set them under Settings > Reverse proxy).
TALLYMED_TRUSTED_PROXIES=
# Encrypts the SMTP password saved under Settings > Email. This is a development-only value; generate your own with `openssl rand -base64 32` for real use.
TALLYMED_SECRETS_KEY=ZGV2LW9ubHktc2VjcmV0cy1rZXktMDEyMzQ1Njc4OWFiY2Q=
# Optional link to corresponding source displayed in the app shell.
TALLYMED_SOURCE_URL=
# Document uploads: Compose mounts a private volume at /var/lib/tallymed/documents. Limits are per file and per household.
# TALLYMED_DOCUMENT_MAX_MB=10
# TALLYMED_DOCUMENT_QUOTA_MB=2048
# TALLYMED_DOCUMENT_RETENTION_DAYS=30
# Optional assistant (MCP) listener, off by default. Needs the `mcp` Compose profile and docs/mcp.md (restricted database role, TLS, allowlist).
# TALLYMED_MCP_ENABLED=false
# TALLYMED_MCP_PUBLISH=127.0.0.1
# TALLYMED_MCP_PORT=8765
