FROM node:24-bookworm-slim AS build
WORKDIR /repo
COPY package*.json ./
COPY tsconfig.base.json ./
COPY apps/marketing/package.json apps/marketing/
COPY apps/web/package.json apps/web/
COPY packages/brand/package.json packages/brand/
RUN npm ci
COPY apps/web apps/web
COPY packages/brand packages/brand
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build -w @tallymed/web

FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000 NEXT_TELEMETRY_DISABLED=1
COPY --from=build --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/web/.next/static ./apps/web/.next/static
# Operator commands (migrate, documents) run from the same image: docker compose run --rm web node apps/web/cli/migrate.ts
COPY --from=build --chown=node:node /repo/apps/web/cli ./apps/web/cli
COPY --from=build --chown=node:node /repo/apps/web/server ./apps/web/server
COPY --from=build --chown=node:node /repo/apps/web/db ./apps/web/db
# The document volume mount point is created owned by the runtime user, mode 0700, so a new named volume is writable and private.
RUN mkdir -p /var/lib/tallymed/documents && chown node:node /var/lib/tallymed/documents && chmod 700 /var/lib/tallymed/documents
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
