# Copy to deploy/.env (never commit it) and replace every value. Generate secrets with: openssl rand -base64 36
POSTGRES_PASSWORD=
# Pin an exact build: sha-<first 12 characters of the release commit>. Do not run `latest` in production.
TALLYMED_IMAGE_TAG=
# Public https origin of the dedicated host that your reverse proxy serves.
TALLYMED_CANONICAL_ORIGIN=https://tallymed.example
# 32 or more random characters, also configured in the proxy as X-Tallymed-Proxy-Secret.
TALLYMED_PROXY_SECRET=
# Link to the corresponding source for the commit you run (AGPL).
TALLYMED_SOURCE_URL=https://github.com/Aulteran/tallymed
# TALLYMED_WEB_PORT=3001
