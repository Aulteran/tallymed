# Copy to deploy/.env (never commit it) and replace every value.
# Passwords that go into database URLs: use hex, `openssl rand -hex 32` (base64 can contain `/` and breaks the URL).
POSTGRES_PASSWORD=
# Pin an exact build. A sha tag is convenient; a digest reference is immutable (the publish job prints it). Never run `latest`.
#   TALLYMED_WEB_IMAGE=ghcr.io/aulteran/tallymed-web:sha-<first 12 characters of the release commit>
#   TALLYMED_WEB_IMAGE=ghcr.io/aulteran/tallymed-web@sha256:<digest>
TALLYMED_WEB_IMAGE=
# Only when you enable the assistant (mcp profile); pin it the same way.
# TALLYMED_MCP_IMAGE=ghcr.io/aulteran/tallymed-mcp:sha-<first 12 characters of the release commit>
# Public https origin of the dedicated host that your reverse proxy serves.
TALLYMED_CANONICAL_ORIGIN=https://tallymed.example
# 32 or more random characters, also configured in the proxy as X-Tallymed-Proxy-Secret: `openssl rand -base64 36`.
TALLYMED_PROXY_SECRET=
# Link to the corresponding source for the commit you run (AGPL).
TALLYMED_SOURCE_URL=https://github.com/Aulteran/tallymed
# TALLYMED_WEB_PORT=3001
