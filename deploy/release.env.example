# Copy to deploy/.env (never commit it) and replace every value.
# Passwords that go into database URLs: use hex, `openssl rand -hex 32` (base64 can contain `/` and breaks the URL).
POSTGRES_PASSWORD=
# Pin an exact build. A sha tag is convenient; a digest reference is immutable (the publish job prints it). Never run `latest`.
#   TALLYMED_WEB_IMAGE=ghcr.io/aulteran/tallymed-web:sha-<first 12 characters of the release commit>
#   TALLYMED_WEB_IMAGE=ghcr.io/aulteran/tallymed-web@sha256:<digest>
TALLYMED_WEB_IMAGE=
# Only when you enable the assistant (mcp profile); pin it the same way.
# TALLYMED_MCP_IMAGE=ghcr.io/aulteran/tallymed-mcp:sha-<first 12 characters of the release commit>
# Public https origin of the dedicated host that your reverse proxy serves.
TALLYMED_CANONICAL_ORIGIN=https://tallymed.example
# 32 or more random characters, also configured in the proxy as X-Tallymed-Proxy-Secret: `openssl rand -base64 36`.
TALLYMED_PROXY_SECRET=
# Address(es) or CIDR range(s) of your reverse proxy, comma separated, as the app sees the connection (see Settings > Reverse proxy). Empty trusts nothing.
TALLYMED_TRUSTED_PROXIES=
# Encrypts the SMTP password saved in the admin pages. `openssl rand -base64 32`. Keep it with your backups; leave empty if you will not store an SMTP password.
TALLYMED_SECRETS_KEY=
# Sign-in with an identity provider (OpenID Connect) is configured in the app under Server settings > Sign-in, not here.
# It needs TALLYMED_SECRETS_KEY above. Example values to enter there (placeholders):
#   Issuer URL     https://auth.example.com/application/o/tallymed/
#   Client ID      tallymed
#   Client secret  (from your provider; stored encrypted)
#   Redirect address to register at the provider: <TALLYMED_CANONICAL_ORIGIN>/api/auth/oidc/callback
# Break-glass: set to "on" to keep password sign-in available even if it was turned off in Sign-in settings.
# TALLYMED_PASSWORD_LOGIN=
# Development only: accept an http or loopback provider (a local test provider). Never set this on a real installation.
# TALLYMED_OIDC_ALLOW_INSECURE_ISSUER=
# Optional: largest backup file (MB) the setup page accepts for a restore. Default 4096. The backup command has no limit.
# TALLYMED_RESTORE_MAX_MB=4096
# Screen lock and "Keep me signed in". An account with a PIN locks after this many seconds without activity (default 300, 180 to 86400);
# the person stays signed in and enters the PIN. A session started with "Keep me signed in" lasts this long in total (default 2592000 = 30 days)
# and ends after this long without use (default 1209600 = 14 days). Set the absolute value to 0 to turn Keep me signed in off. Unchecked sign-ins keep the normal limits in Server settings > General.
# TALLYMED_LOCK_IDLE_SECONDS=300
# TALLYMED_REMEMBER_SESSION_ABSOLUTE_SECONDS=2592000
# TALLYMED_REMEMBER_SESSION_IDLE_SECONDS=1209600
# Link to the corresponding source for the commit you run (AGPL).
TALLYMED_SOURCE_URL=https://github.com/Aulteran/tallymed
# One-time token for creating the first administrator at https://<your origin>/setup. Leave it empty and the server generates a random one
# and prints it to its console (`docker compose ... logs web`) while no administrator exists. If you set it: 32 to 128 random printable characters,
# `openssl rand -base64 32`. It stops working once an administrator exists; remove it from this file afterwards.
TALLYMED_SETUP_TOKEN=
# TALLYMED_WEB_PORT=3001
